# --- Create function to clip a dataset to shapefile
def clip(ds, gdf):
    ds = ds.rio.set_spatial_dims(x_dim="lon", y_dim="lat", inplace=True)
    ds = ds.rio.write_crs("EPSG:4674", inplace=True)
    ds = ds.rio.clip(gdf.geometry, gdf.crs, drop=True, invert=False)
    return ds

# --- Apply clipping
