# ------ Time Series of SPI and FWI (Seasonal Perspective) ------
# Define seasons using month numbers
seasons = {
    "summer": [12, 1, 2],
    "fall": [3, 4, 5],
    "winter": [6, 7, 8],
    "spring": [9, 10, 11],
}

results = {}
for season_name, months in seasons.items():
    print(f"Processing {season_name}...")

    # Select months for the season
    fwi_season = fwi.sel(time=fwi["time.month"].isin(months))
    spi_season = spi.sel(time=spi["time.month"].isin(months))

    # Align in time
    print("Aligning both datasets.")
    #fwi_season, spi_season = xr.align(fwi_season, spi_season)
    print(spi_season)

    # Calculate Pearson correlation
    print(f"Calculating correlation for the {season_name}...")
    r = xr.corr(fwi_season, spi_season, dim="time")

    # Count valid (non-NaN) time steps per pixel
    print("Counting valid timesteps...")
    n = fwi_season.where(np.isfinite(fwi_season) & np.isfinite(spi_season)).count(dim="time")

    # Calculate t-statistic
    print("Calculating t-statistics...")
    t_stat = r * np.sqrt((n - 2) / (1 - r ** 2))

    # Compute p-values (two-tailed test)
    print("Computing p-values...")
    p_val = xr.apply_ufunc(
        lambda t, df: 2 * student_t.sf(np.abs(t), df),
        t_stat, n - 2,
        vectorize=True,
        dask="allowed",
        output_dtypes=[float]
    )

    # Mask r values where not significant
    r_sig = r.where(p_val < 0.05)

    # Save r as GeoTIFF
    print("Saving GeoTIFF of correlation...")
    r.name = "pearson_r"
    r.rio.set_spatial_dims(x_dim="lon", y_dim="lat", inplace=True)
    r.rio.write_crs("EPSG:4674", inplace=True)
    r.rio.to_raster(rf"D:\FACULDADE\FWI\AR1\r_spi_fwi_{season_name}.tif")

    # Extract non-significant areas (p >= 0.05)
    print("Extracting and saving non-significant areas as vector...")
    mask = (p_val >= 0.05).astype("uint8")
    mask.name = "non_significant"
    mask.rio.set_spatial_dims(x_dim="lon", y_dim="lat", inplace=True)
    mask.rio.write_crs("EPSG:4674", inplace=True)

    # Convert mask to numpy array and get transform
    mask_data = mask.astype('uint8').values  # Get the numpy array
    transform = mask.rio.transform()  # Get the affine transform

    # Polygonize the raster
    shapes = features.shapes(mask_data, transform=transform, mask=(mask_data == 1))

    # Convert to GeoDataFrame
    gdf = gpd.GeoDataFrame.from_features(
        [{"properties": {"non_significant": value}, "geometry": geom}
         for geom, value in shapes],
        crs="EPSG:4674"
    )

    # Filter only the significant areas (value == 1)
    gdf = gdf[gdf["non_significant"] == 1].copy()
    gdf = gdf[gdf["non_significant"] == 1].copy()
    gdf["season"] = season_name

    # Save each season's non-significant zones as its own layer in the GeoPackage
    gdf.to_file(rf"D:\FACULDADE\FWI\AR1\non-significant_areas_{season_name}.shp", layer=season_name)

    print(f"{season_name.capitalize()} saved successfully!\n")

    # Store results (optional for further use)
    results[season_name] = {
        "r": r,
        "p": p_val,
        "r_sig": r_sig,
        "t": t_stat,
        "n": n,
    }

